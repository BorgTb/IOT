    {
        "id": "n10034",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Formatear Historial",
        "func": "// Simplifica el nodo Formatear Historial\nconst rows = msg.payload;\nif (!rows || !Array.isArray(rows)) return null;\n\n// Convertimos las filas de la BD en un formato que el gráfico entienda\n// El gráfico necesita un array de objetos {x: tiempo, y: valor}\nreturn [rows.map(row => {\n    return {\n        topic: \"Gas\", // Nombre de la línea en el gráfico\n        payload: row.gas,\n        timestamp: new Date(row.timestamp).getTime()\n    };\n})];",
        "outputs": 1,
