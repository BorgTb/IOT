    {
        "id": "n10024",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Estado del Sistema",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\ncontext.set(\"sys_state\", { movimiento: d.movimiento || false, alerta: d.alerta || \"ninguna\", identidad: d.identidad || \"\", timestamp: Date.now() });\nlet nivel = \"OK\";\nlet mensaje = \"Sistema Normal\";\nlet color = \"#2ecc71\";\nif (d.alerta === \"intruso_detectado\") { nivel = \"ALERTA\"; mensaje = \"INTRUSO DETECTADO\"; color = \"#e74c3c\"; }\nelse if (d.alerta === \"persona_identificada\") { nivel = \"WARNING\"; mensaje = \"Identificado: \" + (d.identidad || \"Desconocido\"); color = \"#f39c12\"; }\nmsg.payload = { nivel: nivel, mensaje: mensaje, color: color };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 940,
        "wires": [
            [
                "n10015",
                "n10025"
            ]
        ]
    },
    {
        "id": "n10025",
        "type": "ui-template",
        "z": "5e16a52bec253e51",
        "group": "n10002",
        "name": "Indicador Estado",
        "order": 0,
        "width": 4,
        "height": 3,
        "templateScope": "local",
        "className": "",
        "x": 950,
        "y": 960,
        "wires": [
            []
        ]
    },
    {
        "id": "n10026",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Actualizar Deteccion",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\nlet motion = d.movimiento ? \"Si\" : \"No\";\nlet person = \"No\";\nif (d.alerta === \"persona_identificada\") person = d.identidad || \"Si\";\nelse if (d.alerta === \"intruso_detectado\") person = \"Desconocido\";\nlet alertText = \"Sin alertas\";\nif (d.alerta === \"intruso_detectado\") alertText = \"INTRUSO detectado\";\nelse if (d.alerta === \"persona_identificada\") alertText = \"Identificado: \" + (d.identidad || \"Desconocido\");\nreturn [\n    { payload: motion },\n    { payload: person },\n    { payload: alertText }\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 620,
        "y": 1040,
        "wires": [
            [
                "n10013"
            ],
            [
                "n10014"
            ],
            [
                "n10015"
            ]
        ]
    },
    {
        "id": "n10028",
        "type": "inject",
        "z": "5e16a52bec253e51",
        "name": "Iniciar BD",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 1,
        "topic": "CREATE TABLE IF NOT EXISTS sensor_history (id INTEGER PRIMARY KEY AUTOINCREMENT, timestamp DATETIME DEFAULT CURRENT_TIMESTAMP, sonido REAL, gas INTEGER, distancia REAL)",
        "payload": "ready",
        "payloadType": "str",
        "x": 1120,
        "y": 1220,
        "wires": [
            [
                "n10027"
            ]
        ]
    },
    {
        "id": "n10029",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Insertar SQLite",
        "func": "const d = msg.payload;\n\n// Si no hay datos, no hacemos nada\nif (!d) return null;\n\n// Extraemos los valores y aseguramos que sean números (si vienen vacíos, ponemos 0)\nconst sonido = d.sonido || 0;\nconst gas = d.gas || 0;\nconst distancia = d.distancia || 0;\n\n// Armamos el texto SQL directamente con los valores (nota las comillas invertidas ` )\nmsg.topic = `INSERT INTO sensor_history (sonido, gas, distancia) VALUES (${sonido}, ${gas}, ${distancia});`;\n\n// Destruimos el payload para que el nodo SQLite solo ejecute el topic crudo\ndelete msg.payload;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 920,
        "y": 900,
        "wires": [
            [
                "n10030"
            ]
        ]
    },
    {
