    {
        "id": "convertir_base64",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Buffer a Base64 JSON",
        "func": "// La API nueva espera un JSON con la imagen en base64\nlet base64Image = msg.payload.toString('base64');\n\nmsg.payload = {\n    \"image\": base64Image\n};\n\n// Asegurar que enviamos JSON\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 240,
        "wires": [
            [
                "post_api_ia"
            ]
        ]
    },
    {
        "id": "post_api_ia",
        "type": "http request",
        "z": "5e16a52bec253e51",
        "name": "POST /recognize",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://api-ia:5000/recognize",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 990,
        "y": 240,
        "wires": [
            [
                "func_evaluar_ia"
            ]
        ]
    },
    {
        "id": "func_evaluar_ia",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Evaluar Rostros",
        "func": "let msg1 = null; // Alerta MQTT\nlet msg3 = { payload: \"\" }; // Texto Dashboard\n\n// Revisar si la API respondió correctamente y trajo rostros\nif (msg.payload && msg.payload.success && msg.payload.rostros && msg.payload.rostros.length > 0) {\n    \n    // Tomar el rostro principal de la lista\n    let rostro = msg.payload.rostros[0]; \n    \n    if (rostro.reconocido) {\n        let alertaJSON = {\n            \"equipo\": \"equipo1\",\n            \"alerta\": \"persona_identificada\",\n            \"identidad\": rostro.nombre,\n            \"movimiento\": true\n        };\n        msg1 = { payload: alertaJSON };\n        msg3.payload = \"🚨 Detectado: \" + rostro.nombre.toUpperCase();\n    } else {\n        let alertaJSON = {\n            \"equipo\": \"equipo1\",\n            \"alerta\": \"intruso_detectado\",\n            \"movimiento\": true\n        };\n        msg1 = { payload: alertaJSON };\n        msg3.payload = \"⚠️ INTRUSO DESCONOCIDO\";\n    }\n} else {\n    // Si no hay rostros o dio error por foto vacía\n    msg3.payload = \"✅ Sin rostros / Escaneando...\";\n}\n\nreturn [msg1, msg3];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 240,
        "wires": [
            [
                "mqtt_out_ia"
            ],
            [
                "f7cc6e66d88ce601"
            ]
        ]
    },
