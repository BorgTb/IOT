        ]
    },
    {
        "id": "a244db115a69c0ab",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Mapear comando LED",
        "func": "const chatId = msg.payload.chatId || '1138232122';\nconst cmd = String(msg.payload.content || '').trim().toUpperCase();\n\nlet accion = '';\nif (cmd === 'ON' || cmd === '1')           accion = 'ON';\nelse if (cmd === 'OFF' || cmd === '0')    accion = 'OFF';\nelse if (cmd === 'TOGGLE' || cmd === 'T') accion = 'TOGGLE';\nelse {\n    return [null, {\n        payload: { chatId: chatId, type: 'message', content: '❌ Usá: /led ON, /led OFF o /led TOGGLE' }\n    }];\n}\n\nreturn [\n    { payload: accion },                                        // Output 1 → MQTT\n    { payload: { chatId: chatId, type: 'message', content: '✅ LED ' + accion } }  // Output 2 → Telegram\n];",
        "outputs": 2,
        "noerr": 0,
        "x": 350,
        "y": 280,
        "wires": [
            [
                "872d075bc1fc910e"
            ],
            [
                "db098d3c7492f41e"
            ]
        ]
    },
