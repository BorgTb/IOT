    {
        "id": "9d4dd51d7b55aefd",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Evaluar Rostros",
        "func": "let msg1 = null; // Alerta MQTT\nlet msg3 = { payload: \"\" }; // Texto Dashboard\nlet msgImagen = null; // Imagen estática para el Dashboard\n\n// Revisar si la API respondió correctamente y trajo rostros\nif (msg.payload && msg.payload.success && msg.payload.rostros && msg.payload.rostros.length > 0) {\n\n    // Tomar el rostro principal de la lista\n    let rostro = msg.payload.rostros[0];\n\n    if (rostro.reconocido) {\n        let alertaJSON = {\n            \"equipo\": \"equipo1\",\n            \"alerta\": \"persona_identificada\",\n            \"identidad\": rostro.nombre,\n            \"movimiento\": true\n        };\n        msg1 = { payload: alertaJSON };\n        msg3.payload = \"🚨 Detectado: \" + rostro.nombre.toUpperCase();\n    } else {\n        let alertaJSON = {\n            \"equipo\": \"equipo1\",\n            \"alerta\": \"intruso_detectado\",\n            \"movimiento\": true\n        };\n        msg1 = { payload: alertaJSON };\n        msg3.payload = \"⚠️ INTRUSO DESCONOCIDO\";\n    }\n\n    // --- NUEVO: Extraemos la foto de la memoria y la enviamos al Dashboard ---\n    let b64 = flow.get('ultima_captura_b64');\n    if (b64) {\n        msgImagen = { payload: \"data:image/jpeg;base64,\" + b64 };\n    }\n\n} else {\n    // Si no hay rostros, actualizamos texto pero NO enviamos imagen.\n    // Así el dashboard se queda congelado en la última persona que pasó.\n    msg3.payload = \"✅ Sin rostros / Escaneando...\";\n}\n\n// Retornamos las 3 salidas\nreturn [msg1, msg3, msgImagen];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1180,
        "y": 220,
        "wires": [
