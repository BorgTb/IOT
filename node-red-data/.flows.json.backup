    {
        "id": "a99506e19d4aad4e",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Verificar umbrales",
        "func": "const d = msg.payload;\nconst cooldown = 2000;\nconst now = Date.now();\nlet alerts = [];\n\nif (d.distancia < 20) {\n    const last = context.get('d_alert') || 0;\n    if (now - last > cooldown) {\n        alerts.push('⚠️ *Distancia crítica!*\\nObjeto a ' + Number(d.distancia).toFixed(1) + ' cm');\n        context.set('d_alert', now);\n    }\n}\nif (d.gas > 100) {\n    const last = context.get('g_alert') || 0;\n    if (now - last > cooldown) {\n        alerts.push('⚠️ *Nivel de gas elevado!*\\nValor: ' + d.gas);\n        context.set('g_alert', now);\n    }\n}\nif (d.sonido > 80) {\n    const last = context.get('s_alert') || 0;\n    if (now - last > cooldown) {\n        alerts.push('⚠️ *Ruido excesivo!*\\n' + d.sonido + '%');\n        context.set('s_alert', now);\n    }\n}\nif (alerts.length > 0) {\n    msg.payload = {\n        chatId: '1138232122',\n        type: 'message',\n        content: '🚨 *ALERTA ESTACIÓN IOT*\\n\\n' + alerts.join('\\n\\n')\n    };\n    return msg;\n}\nreturn null;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 120,
        "wires": [
            [
                "641588c348200e9b",
                "c96ac5a9aff218c0"
            ]
        ]
    },
