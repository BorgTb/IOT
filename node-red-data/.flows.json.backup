                "func_formatear_telegram"
            ]
        ]
    },
    {
        "id": "func_formatear_telegram",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Formatear para Telegram",
        "func": "const data = msg.payload;\n\n// Revisamos si viene la alerta desde MQTT\nif (data && data.alerta) {\n    let mensaje = \"\";\n    \n    // Armamos el texto según el tipo de alerta\n    if (data.alerta === \"persona_identificada\") {\n        mensaje = \"📷 Ingreso detectado: \" + data.identidad.toUpperCase();\n    } else if (data.alerta === \"intruso_detectado\") {\n        mensaje = \"🚨 ALERTA: Intruso desconocido en la cámara.\";\n    }\n\n    // Si hay mensaje, le damos el formato que exige el nodo de Telegram\n    if (mensaje !== \"\") {\n        msg.payload = {\n            chatId: 1138232122,\n            type: \"message\",\n            content: mensaje\n        };\n        return msg;\n    }\n}\n\n// Si no hay alerta que nos interese, no hace nada\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 690,
        "y": 300,
        "wires": [
            [
                "f7cbde09dbdf6e68"
            ]
        ]
    },
