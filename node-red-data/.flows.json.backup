    {
        "id": "dfb145a14722ffad",
        "type": "telegram command",
        "z": "5e16a52bec253e51",
        "name": "Comando /led",
        "command": "/led",
        "bot": "bot.telegram",
        "strict": false,
        "hasresponse": false,
        "useregex": false,
        "outputs": 2,
        "x": 540,
        "y": 520,
        "wires": [
            [
                "dd7bc1eb34d12f6c"
            ],
            []
        ]
    },
    {
        "id": "dd7bc1eb34d12f6c",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Mapear comando LED",
        "func": "const chatId = msg.payload.chatId || '1138232122';\nconst cmd = String(msg.payload.content || '').trim().toUpperCase();\n\nlet accion = '';\nif (cmd === 'ON' || cmd === '1')           accion = 'ON';\nelse if (cmd === 'OFF' || cmd === '0')    accion = 'OFF';\nelse if (cmd === 'TOGGLE' || cmd === 'T') accion = 'TOGGLE';\nelse {\n    return [null, { payload: '❌ Usá: /led ON, /led OFF o /led TOGGLE', chatId: chatId }];\n}\n\nreturn [\n    { payload: accion },                    // Output 1 → MQTT\n    { payload: '✅ LED ' + accion, chatId: chatId }  // Output 2 → Telegram\n];",
        "outputs": 2,
        "noerr": 0,
        "x": 760,
        "y": 520,
        "wires": [
            [
                "e1e4bf3239270914"
            ],
            [
                "7ada31e72254fa2e"
            ]
        ]
    },
