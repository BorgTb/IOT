    {
        "id": "mqtt_in_listener",
        "type": "mqtt in",
        "z": "5e16a52bec253e51",
        "name": "Escuchar Eventos Cámara",
        "topic": "smarthome/equipo1/camara/evento",
        "qos": "0",
        "datatype": "auto-detect",
        "broker": "367352e091ce6828",
        "nl": false,
        "rap": false,
        "inputs": 0,
        "x": 410,
