    {
        "id": "ui_stream_template",
        "type": "ui-template",
        "z": "427c0b64ee6ac87e",
        "group": "group_stream_vivo",
        "page": "",
        "ui": "",
        "name": "Video Stream",
        "order": 1,
        "width": 6,
        "height": 5,
        "format": "<template>\n    <div style=\"display:flex; align-items:center; justify-content:center; width:100%; height:100%;\">\n        <img v-if=\"streamActivo\" :src=\"streamUrl\"\n             style=\"max-width:100%; border-radius:8px; border:2px solid #ccc;\"\n             alt=\"ESP32-CAM Stream\" />\n        <div v-else style=\"color:#999; font-size:14px;\">📷 Cámara inactiva</div>\n    </div>\n</template>\n\n<script>\nexport default {\n    data() {\n        return {\n            streamActivo: false,\n            streamUrl: 'http://172.20.10.8/stream'\n        }\n    },\n    mounted() {\n        this.verificarRuta();\n        this.$watch(\n            () => this.$router?.currentRoute?.value?.path,\n            () => this.verificarRuta()\n        );\n    },\n    methods: {\n        verificarRuta() {\n            const ruta = this.$router?.currentRoute?.value?.path || '';\n            this.streamActivo = ruta.includes('/registro');\n        }\n    }\n}\n</script>",
        "storeOutMessages": true,
        "passthru": true,
        "templateScope": "local",
        "className": "",
        "x": 520,
        "y": 1460,
        "wires": [
            []
        ]
    },
