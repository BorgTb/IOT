    {
        "id": "8fc8caee6749af6d",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Generar SQL por Rango",
        "func": "const rango = msg.payload;\nlet sql = \"\";\n\nif (rango === '1h') {\n    sql = \"SELECT timestamp, gas FROM sensor_history WHERE timestamp >= datetime('now', '-1 hour') ORDER BY timestamp ASC\";\n} else if (rango === '24h') {\n    sql = \"SELECT timestamp, gas FROM sensor_history WHERE timestamp >= datetime('now', '-1 day') ORDER BY timestamp ASC\";\n} else {\n    // Subconsulta para traer los últimos 200 reales y luego ordenarlos cronológicamente\n    sql = \"SELECT * FROM (SELECT timestamp, gas FROM sensor_history ORDER BY timestamp DESC LIMIT 200) ORDER BY timestamp ASC\";\n}\n\nmsg.topic = sql;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1290,
        "y": 980,
        "wires": [
            [
                "eee394b4ed03b044"
            ]
        ]
    },
    {
        "id": "fccb4dbb9abfafb0",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Formatear Historial",
        "func": "const rows = msg.payload;\nif (!rows || !Array.isArray(rows)) return null;\n\nconst mensajes = rows.map((row, index) => {\n    let textDate = String(row.timestamp);\n\n    // Arreglamos el formato de SQLite\n    if (textDate.includes(\" \") && !textDate.includes(\"T\")) {\n        textDate = textDate.replace(\" \", \"T\") + \"Z\";\n    }\n\n    let timeMs = new Date(textDate).getTime();\n\n    if (isNaN(timeMs)) {\n        timeMs = Date.now() - ((rows.length - index) * 1000);\n    }\n\n    return {\n        topic: \"Gas\",\n        payload: row.gas,\n        timestamp: timeMs\n    };\n});\n\n// ¡LA SOLUCIÓN AQUÍ!\n// Metemos un comando de borrado (un payload vacío) al inicio de la fila de mensajes.\n// Así el gráfico se limpia instantáneamente antes de dibujar la nueva consulta.\nmensajes.unshift({ payload: [] });\n\n// Enviamos la ráfaga\nreturn [mensajes];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1490,
        "y": 920,
        "wires": [
            [
                "bb805617eb33953f",
                "c2dab189f25f0e68"
            ]
        ]
    },
