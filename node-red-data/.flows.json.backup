                "6c5e48d237852a15"
            ]
        ]
    },
    {
        "id": "6c5e48d237852a15",
        "type": "http request",
        "z": "427c0b64ee6ac87e",
        "name": "POST /recognize",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://api-ia:5000/recognize",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 990,
