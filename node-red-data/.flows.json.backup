    {
        "id": "47a980e515bc3e0c",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Procesar Dashboard",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\nconst data = {\n    gas: d.gas != null ? d.gas : 0,\n    distancia: d.distancia != null ? d.distancia : 0,\n    sonido: d.sonido != null ? d.sonido : 0,\n    alerta: d.alerta || \"\"\n};\ncontext.set(\"sensor_data\", data);\n// Si no hay datos, en vez de enviar null, enviamos un mensaje vacío \n// que no rompa el gráfico o simplemente no enviamos nada.\nreturn [\n    data ? { payload: data } : null,\n    data ? { payload: data, topic: \"Gas\" } : null, // <-- El truco está en agregar el topic aquí\n    data ? { payload: data } : null\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
