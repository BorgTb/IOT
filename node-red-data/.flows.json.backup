    {
        "id": "5443a0857a966d41",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "function 2",
        "func": "// Recupera el Base64 de la última captura\nlet b64 = flow.get('ultima_captura_b64');\n\nif (!b64) {\n    // Si no hay imagen, devuelve error 404\n    node.status({ fill: \"red\", shape: \"dot\", text: \"sin imagen\" });\n    msg.statusCode = 404;\n    msg.payload = \"No hay ninguna foto capturada aún\";\n    return msg;\n}\n\n// Convertir Base64 a Buffer\nlet imageBuffer = Buffer.from(b64, 'base64');\n\n// Configurar respuesta como imagen JPEG\nmsg.headers = {\n    'Content-Type': 'image/jpeg',\n    'Content-Disposition': 'inline; filename=\"ultima_captura.jpg\"'\n};\nmsg.payload = imageBuffer;\n\nnode.status({ fill: \"green\", shape: \"dot\", text: \"enviada\" });\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 120,
