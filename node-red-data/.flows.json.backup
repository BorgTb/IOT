        "name": "Insertar SQLite",
        "func": "// El objeto data llega en msg.payload desde la salida 3 del nodo anterior\nconst d = msg.payload;\nif (!d) return null;\n\nmsg.topic = \"INSERT INTO sensor_history (temperatura, humedad, gas, distancia) VALUES (?, ?, ?, ?);\";\nmsg.payload = [d.temperatura || 0, d.humedad || 0, d.gas || 0, d.distancia || 0];\n\nreturn msg;",
