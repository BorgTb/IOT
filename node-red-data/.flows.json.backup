    {
        "id": "nodo_armar_train_nuevo",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Preparar POST /train",
        "func": "let nombre = msg.payload.nombre;\nlet imagen = flow.get('ultima_captura_b64');\n\nif (!nombre || nombre.trim() === '') {\n    return [null, { payload: \"⚠️ Escribe el nombre antes de registrar\" }];\n}\nif (!imagen) {\n    return [null, { payload: \"⚠️ Presiona primero el botón de Tomar Captura\" }];\n}\n\nlet base64Full = \"data:image/jpeg;base64,\" + imagen;\n\nmsg.payload = {\n    \"nombre\": nombre.trim(),\n    \"image\": base64Full\n};\nmsg.headers = { \"Content-Type\": \"application/json\" };\n\nreturn [msg, { payload: \"⌛ Procesando biometría en el servidor...\" }];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "x": 960,
        "y": 1400,
        "wires": [
            [
                "nodo_post_train_nuevo"
            ],
            [
                "nodo_estado_registro_nuevo"
            ]
        ]
    },
    {
        "id": "nodo_post_train_nuevo",
        "type": "http request",
        "z": "427c0b64ee6ac87e",
        "name": "POST /train",
        "method": "POST",
        "ret": "obj",
        "paytoqs": "ignore",
        "url": "http://api-ia:5000/train",
        "tls": "",
        "persist": false,
        "proxy": "",
        "insecureHTTPParser": false,
        "authType": "",
        "senderr": false,
        "headers": [],
        "x": 1150,
        "y": 1380,
        "wires": [
            [
                "nodo_resp_train_nuevo"
            ]
        ]
    },
    {
        "id": "nodo_resp_train_nuevo",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Respuesta Train",
        "func": "// Verifica si la respuesta del servidor fue exitosa\nif (msg.payload && msg.payload.success) {\n    // Éxito: se registró correctamente\n    msg.payload = {\n        texto: `✅ EXITOSO: ${msg.payload.nombre} registrado correctamente.`,\n        color: \"#2ecc71\",   // Verde\n        tipo: \"exito\"\n    };\n} else {\n    // Rechazo: mostrar el motivo del error\n    let motivo = msg.payload?.message || \"Error desconocido en el servidor\";\n    // Si hay lista de errores específicos (ej: \"No se detectó ningún rostro\")\n    if (msg.payload?.errores && msg.payload.errores.length > 0) {\n        motivo += \" - \" + msg.payload.errores.join(\", \");\n    }\n    msg.payload = {\n        texto: `❌ RECHAZADO: ${motivo}`,\n        color: \"#e74c3c\",   // Rojo\n        tipo: \"rechazo\"\n    };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1320,
        "y": 1380,
        "wires": [
            [
                "nodo_estado_registro_nuevo"
            ]
        ]
    },
