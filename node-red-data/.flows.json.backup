    {
        "id": "03a830fe843d99d2",
        "type": "function",
        "z": "427c0b64ee6ac87e",
        "name": "Buffer a Base64 JSON",
        "func": "// La API nueva espera un JSON con la imagen en base64\nlet base64Image = msg.payload.toString('base64');\n\n// NUEVO: Guardamos la imagen en memoria para el registro manual\nflow.set('ultima_captura_b64', base64Image);\n\nmsg.payload = {\n    \"image\": base64Image\n};\n\n// Asegurar que enviamos JSON\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 780,
        "y": 220,
        "wires": [
