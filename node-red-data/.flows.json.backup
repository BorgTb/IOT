    {
        "id": "n10016",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Img a Dashboard",
        "func": "if (msg.payload && msg.payload.type === \"Buffer\") {\n    const buf = Buffer.from(msg.payload.data);\n    const b64 = buf.toString(\"base64\");\n    msg.payload = \"data:image/jpeg;base64,\" + b64;\n    return msg;\n}\nif (Buffer.isBuffer(msg.payload)) {\n    const b64 = msg.payload.toString(\"base64\");\n    msg.payload = \"data:image/jpeg;base64,\" + b64;\n    return msg;\n}\nreturn null;",
        "outputs": 1,
