        "name": "Notificar estado LED",
        "func": "const estado = String(msg.payload).toUpperCase();\nconst icono = estado === 'ON' ? '🟢' : '🔴';\nmsg.payload = icono + ' LED ' + (estado === 'ON' ? 'ENCENDIDO' : 'APAGADO');\nmsg.chatId = '1138232122';\nreturn msg;",
