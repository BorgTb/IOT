    {
        "id": "n10032",
        "type": "inject",
        "z": "5e16a52bec253e51",
        "name": "Cargar Historial",
        "props": [
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": true,
        "onceDelay": 3,
        "topic": "SELECT timestamp, gas FROM sensor_history ORDER BY timestamp ASC LIMIT 200",
        "x": 1280,
        "y": 1100,
        "wires": [
            [
                "n10033"
            ]
        ]
    },
    {
        "id": "n10034",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Formatear Historial",
        "func": "const rows = msg.payload;\nif (!rows || !Array.isArray(rows)) return null;\n\nconst mensajes = rows.map((row, index) => {\n    let textDate = String(row.timestamp);\n    \n    // Arreglamos el formato de SQLite \"YYYY-MM-DD HH:MM:SS\" a \"YYYY-MM-DDTHH:MM:SSZ\"\n    if (textDate.includes(\" \") && !textDate.includes(\"T\")) {\n        textDate = textDate.replace(\" \", \"T\") + \"Z\";\n    }\n    \n    let timeMs = new Date(textDate).getTime();\n    \n    // Si por alguna razón extrema la fecha sigue fallando, \n    // separamos los puntos artificialmente para evitar la línea vertical\n    if (isNaN(timeMs)) {\n        timeMs = Date.now() - ((rows.length - index) * 1000);\n    }\n\n    return {\n        topic: \"Gas\",\n        payload: row.gas,\n        timestamp: timeMs\n    };\n});\n\n// Enviamos los mensajes en ráfaga\nreturn [ mensajes ];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1390,
        "y": 900,
        "wires": [
            [
                "n10031"
            ]
        ]
    },
