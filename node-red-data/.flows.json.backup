    {
        "id": "n10024",
        "type": "function",
        "z": "5e16a52bec253e51",
        "name": "Estado del Sistema",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\ncontext.set(\"sys_state\", { movimiento: d.movimiento || false, alerta: d.alerta || \"ninguna\", identidad: d.identidad || \"\", timestamp: Date.now() });\nlet nivel = \"OK\";\nlet mensaje = \"Sistema Normal\";\nlet color = \"#2ecc71\";\nif (d.alerta === \"intruso_detectado\") { nivel = \"ALERTA\"; mensaje = \"INTRUSO DETECTADO\"; color = \"#e74c3c\"; }\nelse if (d.alerta === \"persona_identificada\") { nivel = \"WARNING\"; mensaje = \"Identificado: \" + (d.identidad || \"Desconocido\"); color = \"#f39c12\"; }\nmsg.payload = { nivel: nivel, mensaje: mensaje, color: color };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 940,
        "wires": [
            [
                "n10025",
                "n10015"
            ]
        ]
    },
    {
        "id": "n10025",
        "type": "ui-template",
        "z": "5e16a52bec253e51",
        "group": "n10002",
        "name": "Indicador Estado",
        "order": 0,
        "width": 4,
        "height": 3,
        "templateScope": "local",
        "className": "",
        "x": 950,
