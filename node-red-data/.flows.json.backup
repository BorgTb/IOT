        "z": "5e16a52bec253e51",
        "name": "Procesar Dashboard",
        "func": "const d = msg.payload;\nif (!d || typeof d !== \"object\") return null;\nconst data = {\n    gas: d.gas != null ? d.gas : 0,\n    distancia: d.distancia != null ? d.distancia : 0,\n    sonido: d.sonido != null ? d.sonido : 0,\n    alerta: d.alerta || \"\"\n};\ncontext.set(\"sensor_data\", data);\nreturn [\n    { payload: data },       // Salida 1: Todo el objeto para el Dashboard\n    { payload: data.gas },   // Salida 2: Solo Gas para el Gráfico\n    { payload: data }        // Salida 3: Todo el objeto para SQLite\n];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
