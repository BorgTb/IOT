    {
        "id": "135bff6490734fe8",
        "type": "telegram command",
        "z": "427c0b64ee6ac87e",
        "name": "Comando /led",
        "command": "/led",
        "bot": "bot.telegram",
        "strict": false,
        "hasresponse": false,
        "useregex": false,
        "outputs": 2,
        "x": 130,
        "y": 280,
        "wires": [
            [
                "a244db115a69c0ab"
            ],
